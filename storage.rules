rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(patientUid) {
      return isAuthenticated() && request.auth.uid == patientUid;
    }

    function isAcceptedCaregiver(patientUid) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/caregiverLinks/$(patientUid + '_' + request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/caregiverLinks/$(patientUid + '_' + request.auth.uid)).data.status == 'ACCEPTED';
    }

    // Proof photos: proofs/{patientUid}/{filename}
    match /proofs/{patientUid}/{filename} {
      // Patient can upload proof photo (must be image <= 5MB)
      allow write: if isOwner(patientUid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only patient or linked accepted caregiver can read proof photos
      allow read: if isOwner(patientUid) || isAcceptedCaregiver(patientUid);

      // Patient can delete own proof photos
      allow delete: if isOwner(patientUid);
    }
  }
}
