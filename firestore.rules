rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: is linked accepted caregiver for patient
    function isAcceptedCaregiver(patientId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/caregiverLinks/$(patientId + '_' + request.auth.uid)).data.status == 'ACCEPTED';
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAcceptedCaregiver(userId);
      allow write: if isOwner(userId);

      // Patient medicines subcollection
      match /medicines/{medicineId} {
        allow read: if isOwner(userId) || isAcceptedCaregiver(userId);
        allow write: if isOwner(userId);
      }

      // Patient dose events subcollection
      match /doseEvents/{doseId} {
        allow read: if isOwner(userId) || isAcceptedCaregiver(userId);
        allow write: if isOwner(userId);
      }
    }

    // Caregiver links collection
    match /caregiverLinks/{linkId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverUid == request.auth.uid
      );
      // Ensure linkId strictly matches patientId_caregiverUid, creator is patient, and initial status is PENDING
      allow create: if isAuthenticated() &&
        request.resource.data.patientId == request.auth.uid &&
        linkId == (request.resource.data.patientId + '_' + request.resource.data.caregiverUid) &&
        request.resource.data.status == 'PENDING';
      allow update: if isAuthenticated() && (
        (resource.data.patientId == request.auth.uid && request.resource.data.status in ['PENDING', 'REVOKED']) ||
        (resource.data.caregiverUid == request.auth.uid && request.resource.data.status in ['ACCEPTED', 'REJECTED'])
      );
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // Notification outbox / delivery events
    match /notificationEvents/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.patientUid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.caregiverUid == request.auth.uid
      );
      allow update, delete: if false; // Immutable audit log
    }
  }
}
